# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Search: hybrid (recommended: MiniLM + TF-IDF), minilm or tfidf
EMBEDDING_BACKEND=hybrid
CHUNK_SIZE=40
CHUNK_OVERLAP=10
TOP_K=8

# LLM provider: groq | gemini | openai | ollama | none
# Free options: Groq (console.groq.com) or Google Gemini (aistudio.google.com), or Ollama running locally.
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides (defaults are set per provider in src/config.py)
LLM_MODEL=
LLM_BASE_URL=
# Backup models tried when the main model hits a usage limit (Groq default:
# openai/gpt-oss-120b,qwen/qwen3.8-27b). Comma-separated, or "none" to disable.
LLM_FALLBACK_MODELS=
